@page "/"
@using ServiceAnalytics.Models
<PageTitle>PulseOps | Overview</PageTitle>
<div class="top"><div><p class="eyebrow">MONDAY · OPERATIONS</p><h1>Service health overview</h1><p class="muted">Make support performance visible.</p></div><button class="primary" @onclick="OpenRequest">+ Log request</button></div>
<div class="stats"><div><small>Open requests</small><strong>@Requests.Count(x => x.Status != "Resolved")</strong><em>↓ 8% this week</em></div><div><small>Avg. response</small><strong>2h 18m</strong><em>↓ 14m this week</em></div><div><small>SLA compliance</small><strong>94.6%</strong><em>↑ 3.2% this week</em></div><div><small>Customer effort</small><strong>4.7/5</strong><em>↑ 0.4 this week</em></div></div>
<section class="panel"><div class="section-head"><div><h2>Request performance</h2><p class="muted">Current service queue by category</p></div><select @bind="Filter"><option>All categories</option><option>Access</option><option>Hardware</option><option>Software</option></select></div><div class="bars">@foreach(var group in Groups){<div class="bar-row"><span>@group.Name</span><div class="track"><i style="width:@(group.Count*12)%"></i></div><b>@group.Count</b></div>}</div></section>
<section class="panel"><div class="section-head"><div><h2>Latest requests</h2><p class="muted">Prioritised by operational impact</p></div><a href="requests">View all →</a></div><table><thead><tr><th>Request</th><th>Category</th><th>Priority</th><th>Status</th></tr></thead><tbody>@foreach(var r in VisibleRequests.Take(5)){<tr><td><b>@r.Title</b><small>@r.Requester</small></td><td>@r.Category</td><td><span class="pill @r.Priority.ToLower()">@r.Priority</span></td><td>@r.Status</td></tr>}</tbody></table></section>
@code { record Group(string Name,int Count); string Filter="All categories"; List<Request> Requests=new(){new("VPN access required","Maya Patel","Access","High","Open"),new("Laptop battery replacement","Daniel Smith","Hardware","Medium","In Progress"),new("Design software licence","Lerato Mokoena","Software","Low","Resolved"),new("Shared drive permissions","Aisha Khan","Access","High","Open")}; IEnumerable<Request> VisibleRequests=>Filter=="All categories"?Requests:Requests.Where(x=>x.Category==Filter); IEnumerable<Group> Groups=>new[]{"Access","Hardware","Software"}.Select(x=>new Group(x,Requests.Count(r=>r.Category==x))); void OpenRequest()=>Requests.Insert(0,new Request("New service request","You","Software","Medium","Open"));
}
